# ============================================
# BUCT AI 教学平台 环境变量示例
# 复制本文件为 .env 并按需修改（.env 已被 .gitignore 排除，不会提交）
# ============================================

# ---------- 应用 ----------
APP_NAME=BUCT AI 教学平台
DEBUG=true
API_PREFIX=/api/v1

# ---------- 数据库（学校 buct_cip 库，MariaDB 10.11）----------
DB_HOST=111.228.59.119
DB_PORT=3306
DB_USER=buct_cip
DB_PASSWORD=your-db-password
DB_NAME=buct_cip
# 若需要直连远程 MySQL，可显式配置完整连接串（优先级高于上面的字段）
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/dbname?charset=utf8mb4

# ---------- JWT ----------
SECRET_KEY=please-change-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- 学生端 SSO（学生端后端用共享密钥为学生换教师端 JWT，可选）----------
# 留空 = 关闭 /auth/sso/student-token 接口；填一个随机长字符串供两端约定，只存后端、不入库
# SSO_SHARED_SECRET=

# ---------- 学校 OJ 系统（用于对接判题 / 拉取题目）----------
OJ_API_BASE=https://buctcoder.com
OJ_USERNAME=your-oj-username
OJ_PASSWORD=your-oj-password
OJ_DB_HOST=your-oj-db-host
OJ_DB_PORT=3306
OJ_DB_USER=your-oj-user
OJ_DB_PASSWORD=your-oj-password
OJ_DB_NAME=jol

# ---------- 大模型 API（通义千问 / DeepSeek 等 OpenAI 兼容接口）----------
LLM_API_KEY=your-llm-api-key
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# ---------- 文件存储 ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=100

# ---------- 视频处理（ffmpeg / ffprobe）----------
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# MAX_VIDEO_TRANSCODE_MB=500

# ---------- 阿里云 OSS（对象存储 + 文档在线预览，可选）----------
# 开启后文件会镜像到 OSS，并通过签名 URL 提供下载/预览；Office 文档走 IMM 转 PDF
# OSS_ENABLED=false
# OSS_ACCESS_KEY_ID=your-access-key-id
# OSS_ACCESS_KEY_SECRET=your-access-key-secret
# OSS_BUCKET=your-bucket
# OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
# OSS_REGION=cn-beijing
# OSS_URL_EXPIRES=3600

# ---------- 学情预警阈值 ----------
WARNING_SUBMIT_DELAY_DAYS=3
WARNING_ABSENT_DAYS=3
WARNING_LOW_SCORE=0.3
