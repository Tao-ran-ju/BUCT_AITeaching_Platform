# ============================================
# BUCT AI 教学平台 环境变量示例
# 复制本文件为 .env 并按需修改（.env 已被 .gitignore 排除，不会提交）
# ============================================

# ---------- 应用 ----------
APP_NAME=BUCT AI 教学平台
DEBUG=true
API_PREFIX=/api/v1

# ---------- 数据库（MySQL 8.0）----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=2024040333
DB_NAME=buct_ai_teaching
# 若需要直连远程 MySQL，可显式配置完整连接串（优先级高于上面的字段）
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/dbname?charset=utf8mb4

# ---------- JWT ----------
SECRET_KEY=please-change-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- 学校 OJ 系统（用于对接判题 / 拉取题目）----------
OJ_API_BASE=https://buctcoder.com
OJ_USERNAME=your-oj-username
OJ_PASSWORD=your-oj-password
OJ_DB_HOST=222.199.230.149
OJ_DB_PORT=3306
OJ_DB_USER=your-oj-user
OJ_DB_PASSWORD=your-oj-password
OJ_DB_NAME=jol

# ---------- 大模型 API（通义千问 / DeepSeek 等 OpenAI 兼容接口）----------
LLM_API_KEY=sk-4b76790b9b12416d9caa659cf1d5a503
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# ---------- 文件存储 ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=100

# ---------- 视频处理（ffmpeg / ffprobe）----------
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# MAX_VIDEO_TRANSCODE_MB=500

# ---------- 学情预警阈值 ----------
WARNING_SUBMIT_DELAY_DAYS=3
WARNING_ABSENT_DAYS=3
WARNING_LOW_SCORE=0.3
